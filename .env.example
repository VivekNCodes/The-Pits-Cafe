# Database connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/restaurant_platform?schema=public"

# App public URL for QR generation and canonical links
